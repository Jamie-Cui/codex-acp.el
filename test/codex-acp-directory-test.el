(ert-deftest codex-acp-directory-test-remote-host-check-before-io ()
  (let ((default-directory "/ssh:test@host:/project/") touched)
    (cl-letf (((symbol-function 'file-truename) (lambda (path) (setq touched t) path))
              ((symbol-function 'file-directory-p) (lambda (_) t)))
