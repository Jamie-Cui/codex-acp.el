;;; codex-acp-directory-test.el --- Scoped directory grants -*- lexical-binding: t; no-byte-compile: t -*-

;; Offline tests: initialize packages, add the package directory to load-path, load this
;; file and run ert-run-tests-batch-and-exit.  No model or remote host is used.

(require 'ert)
(require 'codex-acp)
(require 'codex-acp-worker)

(defmacro codex-acp-directory-test--workspace (&rest body)
  "Run BODY with isolated project, notes and unrelated directory fixtures."
  (declare (indent 0) (debug t))
  `(let* ((base (file-name-as-directory (file-truename (make-temp-file "acp-dirs-" t))))
          (project (expand-file-name "project/" base))
          (notes (expand-file-name "notes/" base))
          (other (expand-file-name "notes-other/" base)))
     (unwind-protect
         (progn
           (mapc (lambda (dir) (make-directory dir t)) (list project notes other))
           (let* ((default-directory project)
                  (state (codex-acp--state-create :directory project :thread "existing-thread"))
          (client (list (cons :codex-acp-state state) (cons :codex-acp-scope 'directory)
                        (cons :request-handlers nil) (cons :notification-handlers nil)
                        (cons :codex-acp-allowed-directories nil))))
             (setf (codex-acp--state-client state) client)
             ,@body))
       (delete-directory base t))))

(ert-deftest codex-acp-directory-test-worker-survives-package-relocation ()
  "Fresh workers load the adapter and worker from the package directory."
  (skip-unless noninteractive)
  (codex-acp-directory-test--workspace
    (write-region "Worker relocation OK\n" nil (concat project "source.el") nil 'silent)
    (dolist (library (list codex-acp--worker-library))
      (let ((tramp-async--workers (make-hash-table :test #'equal))
            (deadline (+ (float-time) 15))
            result)
        (unwind-protect
            (progn
              (tramp-async-call
               project #'codex-acp-worker-execute
               '(((tool . "tramp_read_file")
                  (arguments . ((path . "source.el")))
                  (fileSizeLimit . 4096) (outputLimit . 4096)))
               (lambda (value) (setq result value))
               :library library :timeout 10 :mutating nil)
              (while (and (not result) (< (float-time) deadline))
                (accept-process-output nil 0.05))
              (ert-info ((format "Worker library: %s; result: %S" library result))
                (should result)
                (should (eq (plist-get result :status) 'ok))
                (should (equal (plist-get result :value)
                               '(t . "Worker relocation OK\n")))))
          (tramp-async-shutdown))))))

(ert-deftest codex-acp-directory-test-path-boundary ()
  (codex-acp-directory-test--workspace
    (let ((request `((allowedDirectories . (,notes)))))
      (should-error (codex-acp-worker--path nil (concat notes "report.org")))
      (should (equal (codex-acp-worker--path request (concat notes "new/report.org"))
                     (concat notes "new/report.org")))
      (should (equal (codex-acp-worker--path request "source.el") (concat project "source.el")))
      (dolist (path (list (concat other "report.org") (concat notes "../notes-other/report.org")
                         "/ssh:elsewhere:/notes/report.org" "~/.emacs.d/test"))
        (should-error (codex-acp-worker--path request path)))
      (make-symbolic-link other (concat notes "escape"))
      (should-error (codex-acp-worker--path request (concat notes "escape/report.org")))
      ;; Skill roots remain read-only exceptions, separate from user grants.
      (push (cons 'skills (list other)) request)
      (should (equal (codex-acp-worker--path request (concat other "SKILL.md") t)
                     (concat other "SKILL.md")))
      (should-error (codex-acp-worker--path request (concat other "SKILL.md"))))))

(ert-deftest codex-acp-directory-test-policy-precedes-same-thread-turn ()
  (codex-acp-directory-test--workspace
    (setf (map-elt (codex-acp--state-client state) :codex-acp-allowed-directories) (list notes)
          (codex-acp--state-prompt state) (cons #'ignore #'ignore))
    (let ((input '(((type . "text") (text . "Continue the existing task")))))
      (let (injected acknowledge sent)
        (cl-letf (((symbol-function 'codex-acp--rpc)
                   (lambda (_state method params success _failure &rest _)
                     (should (equal (map-elt params 'threadId) "existing-thread"))
                     (cond ((equal method "thread/inject_items")
                            (setq injected params acknowledge success))
                           ((equal method "turn/start") (setq sent params))
                           (t (ert-fail method))))))
          (codex-acp--start-turn state input)
          (should-not sent)
          (let* ((item (aref (map-elt injected 'items) 0))
                 (text (map-elt (aref (map-elt item 'content) 0) 'text)))
            (should (equal (map-elt item 'role) "developer"))
            (should (string-match-p (regexp-quote notes) text))
            (should (string-match-p "supersedes" text)))
          (funcall acknowledge nil)
          (should (equal (map-elt sent 'input) (vconcat input)))
          (should (equal (codex-acp--state-thread state) "existing-thread"))
          ;; The next connection's empty policy must supersede saved grants.
          (setf (map-elt (codex-acp--state-client state) :codex-acp-allowed-directories) nil)
          (codex-acp--start-turn state input)
          (should-not (string-match-p (regexp-quote notes) (prin1-to-string injected))))))))

(ert-deftest codex-acp-directory-test-ssh-policy-in-new-and-restored-turns ()
  "New threads and refreshed turns agree on approved SSH and file boundaries."
  (codex-acp-directory-test--workspace
    (dolist (directory (list project "/ssh:research.example:/project/"))
      (setf (codex-acp--state-directory state) directory)
      (dolist (scope '(directory host))
        (setf (map-elt client :codex-acp-scope) scope
              (codex-acp--state-prompt state) (cons #'ignore #'ignore))
        (let (injected)
          (cl-letf (((symbol-function 'codex-acp--rpc)
                     (lambda (_state method params _success &rest _)
                       (should (equal method "thread/inject_items"))
                       (setq injected params))))
            (codex-acp--start-turn state nil))
          (dolist (policy
                   (list (map-elt (codex-acp--thread-params state) 'developerInstructions)
                         (map-elt (aref (map-elt (aref (map-elt injected 'items) 0) 'content) 0)
                                  'text)))
            (should (string-match-p "SSH remote commands and scp/rsync file transfers" policy))
            (should (string-match-p "allowed only through tramp_run_command.*approval flow" policy))
            (should (string-match-p "supersedes earlier blanket bans on using other hosts" policy))
            (should (string-match-p "File tools and command cwd must stay on the session host" policy))
            (should (string-match-p "Do not create tunnels, port forwarding" policy))
            (should (string-match-p "SSH -L, -R, -D, -w or equivalent configuration options" policy))
            (should-not (string-match-p "Do not use .*or other hosts" policy))))))))

(ert-deftest codex-acp-directory-test-policy-failure-cancel-and-stale-ack ()
  (codex-acp-directory-test--workspace
    (let (ack fail sent failure completed)
      (cl-letf (((symbol-function 'codex-acp--rpc)
                 (lambda (_state method _params success reject &rest _)
                   (if (equal method "thread/inject_items") (setq ack success fail reject)
                     (setq sent t)))))
        (setf (codex-acp--state-prompt state) (cons #'ignore (lambda (err) (setq failure err))))
        (codex-acp--start-turn state nil)
        (funcall fail '((message . "Injection rejected")))
        (should failure)
        (should-not sent)
        (setf (codex-acp--state-prompt state) (cons (lambda (value) (setq completed value)) #'ert-fail))
        (codex-acp--start-turn state nil)
        (setf (codex-acp--state-cancelling state) t)
        (funcall ack nil)
        (should (equal (map-elt completed 'stopReason) "cancelled"))
        (should-not sent)
        (setf (codex-acp--state-prompt state) (cons #'ignore #'ignore))
        (codex-acp--start-turn state nil)
        (setf (codex-acp--state-prompt state) (cons #'ignore #'ignore))
        (funcall ack nil)
        (should-not sent)))))

(defmacro codex-acp-directory-test--transport (&rest body)
  "Run BODY with a current turn, real path checks and captured wire messages."
  (declare (indent 0) (debug t))
  `(codex-acp-directory-test--workspace
     (let ((original-write (symbol-function 'codex-acp--write))
           (original-submit (symbol-function 'codex-acp--submit-job))
           approvals updates wire)
       (setf (codex-acp--state-turn state) "turn"
             (codex-acp--state-prompt state) (cons #'ignore #'ignore)
             (map-elt client :request-handlers) (list (lambda (request) (push request approvals)))
             (map-elt client :notification-handlers) (list (lambda (update) (push update updates))))
       (cl-letf (((symbol-function 'codex-acp--write)
                  (lambda (target message)
                    (if (eq target state) (push message wire) (funcall original-write target message))))
                 ((symbol-function 'codex-acp--submit-job)
                  (lambda (target id function arguments callback timeout mutating &optional lane)
                    (if (not (eq target state))
                        (funcall original-submit target id function arguments callback timeout mutating lane)
                      (let ((result (condition-case err
                                        (list :status 'ok :value (apply function arguments))
                                      (error (list :status 'error :error err)))))
                        (funcall callback result))))))
         (unwind-protect (progn ,@body)
           (codex-acp--close state "Test cleanup"))))))

(defun codex-acp-directory-test--call (tool path &optional id)
  "Build TOOL's pending call for PATH and optional ID."
  `((threadId . "existing-thread") (turnId . "turn") (callId . ,(or id "call"))
    (tool . ,tool) (arguments . ((path . ,path) (text . "Session note")))))

(defun codex-acp-directory-test--answer (client id option)
  "Answer CLIENT's pending ID with OPTION, or cancel when nil."
  (codex-acp--response
   :client client
   :response `(:request-id ,id :result ((outcome . ,(if option
                                                    `((outcome . "selected") (optionId . ,option))
                                                  '((outcome . "cancelled"))))))))

(ert-deftest codex-acp-directory-test-automatic-read-and-expiry ()
  (codex-acp-directory-test--transport
    ;; Older live connections need not have a preallocated grant field.
    (setf (codex-acp--state-client state)
          (assq-delete-all :codex-acp-allowed-directories client))
    (with-temp-file (concat notes "note") (insert "Read after approval"))
    (let ((prompt (codex-acp--state-prompt state)))
      (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_read_file" (concat notes "note")))
      (should (= (length approvals) 1))
      (should-not wire)
      (should-not (codex-acp-allowed-directories client))
      (should (equal notes (map-nested-elt (car approvals) '(params toolCall rawInput path))))
      (should (equal '("allow_once" "allow_always" "reject_once")
                     (mapcar (lambda (option) (map-elt option 'kind))
                             (map-nested-elt (car approvals) '(params options)))))
      (codex-acp-directory-test--answer client 1 "allow-directory")
      (should (equal (codex-acp-allowed-directories client) (list notes)))
      (should (eq (map-nested-elt (car wire) '(result success)) t))
      (should (string-match-p "Read after approval" (prin1-to-string wire)))
      (should (eq prompt (codex-acp--state-prompt state)))
      (should (equal (codex-acp--state-thread state) "existing-thread"))
      (should (equal (codex-acp--state-directory state) project))
      (codex-acp-directory-test--answer client 1 "allow-directory")
      (should (= (length wire) 1))
      (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_read_file" (concat notes "note")))
      (should (= (length approvals) 1))
      (should (= (length wire) 2))
      (let ((copy (codex-acp-allowed-directories client)))
        (setcar copy other)
        (should (equal (codex-acp-allowed-directories client) (list notes)))))
    (codex-acp--close state "Disconnected")
    (should-not (codex-acp-allowed-directories client))
    (should-not (map-elt client :codex-acp-allowed-directories))))

(ert-deftest codex-acp-directory-test-turn-grant-reuse-steer-and-next-turn ()
  (codex-acp-directory-test--transport
    (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes))
    (codex-acp-directory-test--answer client 1 "allow-directory-turn")
    (should (equal (codex-acp-allowed-directories client) (list notes)))
    (should (equal (map-elt (codex-acp--state-client state) :codex-acp-turn-directories)
                   (cons "turn" (list notes))))
    (should-not (map-elt client :codex-acp-allowed-directories))
    ;; Repeated delivery cannot run the approved operation twice.
    (codex-acp-directory-test--answer client 1 "allow-directory-turn")
    (should (= 1 (length wire)))
    (let (steered)
      (cl-letf (((symbol-function 'codex-acp--process-live-p) (lambda (_) t))
                ((symbol-function 'codex-acp--rpc)
                 (lambda (_state method params success _failure &rest _)
                   (should (equal method "turn/steer"))
                   (should (equal (map-elt params 'expectedTurnId) "turn"))
                   (funcall success '((turnId . "turn"))))))
        (codex-acp-steer client "existing-thread" [((type . "text") (text . "Continue"))]
                         (lambda (turn) (setq steered turn)) #'ert-fail))
      (should (equal steered "turn")))
    (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_list_directory" notes))
    (should (= 1 (length approvals)))
    (should (= 2 (length wire)))
    (cl-letf (((symbol-function 'codex-acp--title-start) #'ignore))
      (codex-acp--turn-notification
       state "turn/completed" '((threadId . "existing-thread") (turn . ((id . "turn") (status . "completed"))))))
    (should-not (codex-acp-allowed-directories client))
    (should-not (map-elt (codex-acp--state-client state) :codex-acp-turn-directories))
    (should-not (string-match-p (regexp-quote notes) (codex-acp--directory-instructions state)))
    (setf (codex-acp--state-turn state) "next"
          (codex-acp--state-prompt state) (cons #'ignore #'ignore))
    (let ((call (copy-tree (codex-acp-directory-test--call "tramp_list_directory" notes))))
      (setf (alist-get 'turnId call) "next")
      (codex-acp--tool-call state 3 call))
    (should (= 2 (length approvals)))
    (should (= 2 (length wire)))))

(ert-deftest codex-acp-directory-test-mixed-scopes-expire-independently ()
  (codex-acp-directory-test--transport
    (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes))
    (codex-acp-directory-test--answer client 1 "allow-directory-turn")
    (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_list_directory" other))
    (codex-acp-directory-test--answer client 2 "allow-directory")
    ;; Granting another directory for the session must not promote turn grants.
    (should (equal (map-elt client :codex-acp-allowed-directories) (list other)))
    (should (equal (codex-acp-allowed-directories client) (list other notes)))
    (let ((copy (codex-acp-allowed-directories client)))
      (setcar copy project)
      (setcar (cdr copy) project)
      (should (equal (codex-acp-allowed-directories client) (list other notes))))
    (cl-letf (((symbol-function 'codex-acp--title-start) #'ignore))
      (codex-acp--finish state))
    (should (equal (codex-acp-allowed-directories client) (list other)))
    (should-not (string-match-p (regexp-quote (concat notes "\""))
                               (codex-acp--directory-instructions state)))
    (setf (codex-acp--state-turn state) "next"
          (codex-acp--state-prompt state) (cons #'ignore #'ignore))
    (let ((call (copy-tree (codex-acp-directory-test--call "tramp_list_directory" other))))
      (setf (alist-get 'turnId call) "next")
      (codex-acp--tool-call state 3 call))
    (should (= 2 (length approvals)))
    (should (= 3 (length wire)))
    (codex-acp--close state "Disconnected")
    (should-not (codex-acp-allowed-directories client))))

(ert-deftest codex-acp-directory-test-turn-grants-expire-on-failure-and-cancel ()
  (dolist (ending '(failure cancel disconnect changed-turn))
    (codex-acp-directory-test--transport
      (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes))
      (codex-acp-directory-test--answer client 1 "allow-directory-turn")
      (should (codex-acp-allowed-directories client))
      (pcase ending
        ('failure (codex-acp--finish state '((message . "Failed"))))
        ('cancel (cl-letf (((symbol-function 'codex-acp--rpc) #'ignore))
                   (codex-acp--interrupt state)))
        ('disconnect (codex-acp--close state "Disconnected"))
        ('changed-turn (setf (codex-acp--state-turn state) "next")))
      (should-not (codex-acp-allowed-directories client))
      (unless (eq ending 'changed-turn)
        (should-not (map-elt (codex-acp--state-client state) :codex-acp-turn-directories))))))

(ert-deftest codex-acp-directory-test-old-pending-options-remain-exact ()
  (dolist (option '("allow-directory" "allow-directory-turn"))
    (codex-acp-directory-test--transport
      (let ((call (cons (cons :directory notes)
                        (codex-acp-directory-test--call "tramp_list_directory" notes))))
        ;; This is the pending shape used before scope choices were introduced.
        (setf (codex-acp--state-permissions state) (list (cons 1 call)))
        (codex-acp-directory-test--answer client 1 option)
        (if (equal option "allow-directory")
            (progn
              (should (equal (map-elt client :codex-acp-allowed-directories) (list notes)))
              (should (eq (map-nested-elt (car wire) '(result success)) t)))
          (should-not (codex-acp-allowed-directories client))
          (should (eq (map-nested-elt (car wire) '(result success)) :false)))))))

(ert-deftest codex-acp-directory-test-denied-cancelled-and-wrong-option ()
  (dolist (option '("reject" nil "allow"))
    (codex-acp-directory-test--transport
      (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes))
      (codex-acp-directory-test--answer client 1 option)
      (should-not (codex-acp-allowed-directories client))
      (should-not (codex-acp--state-permissions state))
      (should (eq (map-nested-elt (car wire) '(result success)) :false))
      (should (= (length wire) 1)))))

(ert-deftest codex-acp-directory-test-write-retains-operation-approval ()
  (codex-acp-directory-test--transport
    (let ((path (concat notes "new-file")))
      (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_write_file" path))
      (should-not (file-exists-p path))
      (should (seq-find (lambda (option) (equal (map-elt option 'kind) "allow_once"))
                         (map-nested-elt (car approvals) '(params options))))
      (codex-acp-directory-test--answer client 1 "allow")
      (should-not (file-exists-p path))
      (should-not wire)
      (should (= (length approvals) 2))
      (should (equal (map-elt (seq-find (lambda (option) (equal (map-elt option 'kind) "allow_once"))
                         (map-nested-elt (car approvals) '(params options))) 'optionId)
                     "allow-directory-turn"))
      ;; This synchronous fixture has no parent IPC; the real-worker test
      ;; below exercises the visiting-buffer write guard without stubbing it.
      (let ((check-write (symbol-function 'tramp-async-worker--check-write)))
        (cl-letf (((symbol-function 'tramp-async-worker--check-write)
                   (lambda (file) (unless (equal file path) (funcall check-write file)))))
          (codex-acp-directory-test--answer client 1 "allow-directory")))
      (should (file-exists-p path))
      (should (eq (map-nested-elt (car wire) '(result success)) t))
      ;; The directory grant never approves a later write operation.
      (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_write_file" path))
      (should (= (length approvals) 3))
      (should (seq-find (lambda (option) (equal (map-elt option 'kind) "allow_once"))
                         (map-nested-elt (car approvals) '(params options))))
      (codex-acp-directory-test--answer client 2 "reject"))))

(ert-deftest codex-acp-directory-test-ssh-commands-retain-operation-approval ()
  "SSH and transfers never execute before approval or after a rejection."
  (codex-acp-directory-test--transport
    (dolist (argv '(("ssh" "research.example" "pwd")
                    ("scp" "research.example:/paper/submission.pdf" "submission.pdf")
                    ("rsync" "-a" "-e" "ssh" "research.example:/paper/archive/" "archive/")))
      (let ((call `((threadId . "existing-thread") (turnId . "turn") (callId . ,(car argv))
                    (tool . "tramp_run_command") (arguments . ((argv . ,argv)))))
            executed)
        (setq approvals nil wire nil)
        (cl-letf (((symbol-function 'tramp-async-worker-run)
                   (lambda (operation args)
                     (should (eq operation 'process-file))
                     (should (equal (file-name-as-directory (plist-get args :cwd)) project))
                     (push (plist-get args :argv) executed)
                     '(:status exit :exit 0 :output "Completed"))))
          (codex-acp--tool-call state 1 call)
          (should (= (length approvals) 1))
          (should (equal (map-nested-elt (car approvals) '(params toolCall rawInput argv)) argv))
          (should (equal (map-elt (seq-find (lambda (option) (equal (map-elt option 'kind) "allow_once"))
                         (map-nested-elt (car approvals) '(params options))) 'optionId) "allow"))
          (should-not executed)
          (codex-acp-directory-test--answer client 1 "reject")
          (should-not executed)
          (should (eq (map-nested-elt (car wire) '(result success)) :false))
          (codex-acp--tool-call state 2 call)
          (should (= (length approvals) 2))
          (should-not executed)
          (codex-acp-directory-test--answer client 2 "allow")
          (should (equal executed (list argv)))
          (should (eq (map-nested-elt (car wire) '(result success)) t))
          (codex-acp-directory-test--answer client 2 "allow")
          (should (equal executed (list argv))))))))

(ert-deftest codex-acp-directory-test-command-cwd-and-directory-paths ()
  (codex-acp-directory-test--transport
    (let ((call `((threadId . "existing-thread") (turnId . "turn") (callId . "command")
                  (tool . "tramp_run_command")
                  (arguments . ((cwd . ,notes) (argv . (,(executable-find "printf") "%s" "Ran once")))))))
      (codex-acp--tool-call state 1 call)
      (codex-acp-directory-test--answer client 1 "allow")
      (should (equal notes (map-nested-elt (car approvals) '(params toolCall rawInput path))))
      (should-not wire)
      (codex-acp-directory-test--answer client 1 "allow-directory")
      (should (eq (map-nested-elt (car wire) '(result success)) t))
      (should (string-match-p "Ran once" (prin1-to-string wire))))
    ;; A new directory is scoped to itself, never implicitly to its parent.
    (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_list_directory" (concat other "missing")))
    (should (equal (concat other "missing/")
                   (map-nested-elt (car approvals) '(params toolCall rawInput path))))))

(ert-deftest codex-acp-directory-test-canonical-target-and-symlink-change ()
  (codex-acp-directory-test--transport
    (let ((alias (concat project "alias")))
      (make-symbolic-link notes alias)
      (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" alias))
      (should (equal notes (map-nested-elt (car approvals) '(params toolCall rawInput path))))
      (delete-file alias)
      (make-symbolic-link other alias)
      (codex-acp-directory-test--answer client 1 "allow-directory")
      (should (equal (codex-acp-allowed-directories client) (list notes)))
      (should-not wire)
      (should (= (length approvals) 2))
      (should (equal other (map-nested-elt (car approvals) '(params toolCall rawInput path))))
      (codex-acp-directory-test--answer client 1 "reject")
      (should (eq (map-nested-elt (car wire) '(result success)) :false)))))

(ert-deftest codex-acp-directory-test-no-grant-after-turn-change-or-disconnect ()
  (dolist (option '("allow-directory" "allow-directory-turn"))
    (dolist (change '(cancel finish replace disconnect))
      (codex-acp-directory-test--transport
        (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes))
        (pcase change
          ('cancel (setf (codex-acp--state-cancelling state) t))
          ('finish (setf (codex-acp--state-prompt state) nil))
          ('replace (setf (codex-acp--state-turn state) "new-turn"))
          ('disconnect (codex-acp--close state "Disconnected")))
        (codex-acp-directory-test--answer client 1 option)
        (should-not (codex-acp-allowed-directories client))
        (should-not (codex-acp--state-permissions state))))))

(ert-deftest codex-acp-directory-test-late-worker-result-and-uncertain-failure ()
  (dolist (change '(cancel finish replace disconnect uncertain))
    (codex-acp-directory-test--transport
      (let (callback)
        (cl-letf (((symbol-function 'codex-acp--submit-job)
                   (lambda (_state _id _fn _args done &rest _) (setq callback done))))
          (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_list_directory" notes)))
        (pcase change
          ('cancel (setf (codex-acp--state-cancelling state) t))
          ('finish (setf (codex-acp--state-prompt state) nil))
          ('replace (setf (codex-acp--state-prompt state) (cons #'ignore #'ignore)))
          ('disconnect (codex-acp--close state "Disconnected")))
        (funcall callback (list :status 'error :error (list 'codex-acp-directory-required notes)
                                :uncertain (eq change 'uncertain)))
        (should-not approvals)
        (should-not (codex-acp-allowed-directories client))
        (when (eq change 'uncertain)
          (should (eq (map-nested-elt (car wire) '(result success)) :false)))))))

