(ert-deftest codex-acp-directory-test-real-worker-read-write ()
  "Exercise the complete permission/retry flow in a disposable child Emacs."
  (codex-acp-directory-test--transport
    (let ((tramp-async--workers (make-hash-table :test #'equal))
          (path (concat notes "report.org")))
      (cl-letf (((symbol-function 'codex-acp--submit-job) original-submit))
        (cl-labels ((await-result ()
                      (let ((deadline (+ (float-time) 15)))
                        (while (and (codex-acp--state-jobs state) (< (float-time) deadline))
                          (accept-process-output nil 0.02)))
                      (should-not (codex-acp--state-jobs state))))
          (unwind-protect
              (progn
                (codex-acp--tool-call state 1 (codex-acp-directory-test--call "tramp_write_file" path))
                (codex-acp-directory-test--answer client 1 "allow")
                (await-result)
                (should-not (file-exists-p path))
                (should (= (length approvals) 2))
                (codex-acp-directory-test--answer client 1 "allow-directory")
                (await-result)
                (should (file-exists-p path))
                (should (eq (map-nested-elt (car wire) '(result success)) t))
                (codex-acp--tool-call state 2 (codex-acp-directory-test--call "tramp_read_file" path))
                (await-result)
                (should (string-match-p "Session note" (prin1-to-string (car wire)))))
            (tramp-async-shutdown)))))))

